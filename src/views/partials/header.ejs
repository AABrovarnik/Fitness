<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · FitClub Personal</title>
  <link rel="stylesheet" href="/static/styles.css" />
</head>
<body>
<header class="header">
  <nav class="container nav">
    <a href="/" class="brand">FitClub Personal</a>
    <div class="menu">
      <% if (!user) { %>
        <a href="/login">Войти</a>
        <a href="/register">Регистрация</a>
      <% } else if (user.role === 'client') { %>
        <a href="/client">Кабинет</a>
        <a href="/client/chat">Чат</a>
        <form method="post" action="/auth/logout"><button class="link-btn" type="submit">Выйти</button></form>
      <% } else { %>
        <a href="/admin">Админка</a>
        <a href="/admin/settings">Настройки</a>
        <form method="post" action="/auth/logout"><button class="link-btn" type="submit">Выйти</button></form>
      <% } %>
    </div>
  </nav>
</header>
<main class="container">
