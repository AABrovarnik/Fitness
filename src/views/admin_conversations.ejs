<%- include('partials/header', { title: 'Обращения', user }) %>
<h1>Очередь обращений</h1>
<nav class="tabs"><a href="/admin">Сводка</a><a href="/admin/clients">Клиенты</a><a href="/admin/memberships">Абонементы</a><a href="/admin/schedule">Расписание</a><a href="/admin/equipment">Оборудование</a><a href="/admin/conversations">Обращения</a><a href="/admin/settings">Настройки</a></nav>
<div class="table-wrap">
<table>
  <thead><tr><th>Тема</th><th>Контакт</th><th>Статус</th><th>Режим</th><th>Действие</th></tr></thead>
  <tbody>
  <% conversations.forEach((c) => { %>
    <tr>
      <td><%= c.topic %></td>
      <td><%= c.guest_contact || c.client_id || '-' %></td>
      <td><%= c.status %></td>
      <td><%= c.mode %></td>
      <td>
        <form onsubmit="reply(event, '<%= c.id %>')" class="row">
          <input name="content" placeholder="Ответ" required />
          <button type="submit">Отправить</button>
        </form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<p id="adminConvResult" class="muted"></p>
<script>
  async function reply(event, id) {
    event.preventDefault();
    const content = event.target.content.value;
    const response = await csrfFetch(`/api/admin/conversations/${id}/reply`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ content })
    });
    const result = await response.json();
    document.getElementById('adminConvResult').textContent = result.ok ? 'Ответ отправлен.' : result.error;
    if (result.ok) event.target.reset();
  }
</script>
<%- include('partials/footer') %>

