<%- include('partials/header', { title: 'Чат', user }) %>
<h1>Чат с клубом</h1>
<nav class="tabs">
  <a href="/client">Обзор</a><a href="/client/profile">Профиль</a><a href="/client/bookings">Записи</a><a href="/client/history">История</a><a href="/client/memory">Память AI</a><a href="/client/chat">Чат</a>
</nav>
<div class="card">
  <p><strong>Тема:</strong> <%= conversation.topic %> · <strong>Статус:</strong> <%= conversation.status %> · <strong>Режим:</strong> <%= conversation.mode %></p>

  <% if (messages.length > 1) { %>
    <section class="card latest-exchange">
      <h3>Последний обмен</h3>
      <% const lastUser = [...messages].reverse().find(m => m.author_role === 'client'); %>
      <% const lastReply = [...messages].reverse().find(m => m.author_role === 'ai' || m.author_role === 'admin'); %>
      <% if (lastUser) { %><p><strong>Вы:</strong> <%= lastUser.content %></p><% } %>
      <% if (lastReply) { %><p><strong>Ответ:</strong> <%= lastReply.content %></p><% } %>
    </section>
  <% } %>

  <div id="chatBox" class="chat-box" tabindex="0">
    <% messages.forEach((m, idx) => { %>
      <div class="msg <%= m.author_role %> <%= idx === messages.length - 1 ? 'latest' : '' %>">
        <small><%= m.author_role %> · <%= formatDateTime(m.created_at) %></small>
        <p><%= m.content %></p>
      </div>
    <% }) %>
  </div>
  <form id="chatForm" class="stack">
    <label for="chatMode">Режим чата</label>
    <select id="chatMode" name="mode" aria-label="Режим чата">
      <option value="ai">AI-консультант</option>
      <option value="trainer">AI-тренер</option>
      <option value="human">Позвать администратора</option>
    </select>
    <label for="chatInput">Ваш вопрос</label>
    <textarea id="chatInput" name="content" rows="3" placeholder="Ваш вопрос" required></textarea>
    <button id="chatSubmit" type="submit">Отправить</button>
  </form>
  <p id="chatResult" class="muted" aria-live="polite"></p>
</div>
<script>
  const chatBox = document.getElementById('chatBox');
  const chatInput = document.getElementById('chatInput');
  if (chatBox) {
    const messages = Array.from(chatBox.querySelectorAll('.msg'));
    const lastClient = [...messages].reverse().find((node) => node.classList.contains('client'));
    const lastReply = [...messages].reverse().find((node) => node.classList.contains('ai') || node.classList.contains('admin'));
    const focusTarget = lastReply || lastClient || chatBox.querySelector('.msg.latest');
    if (focusTarget) {
      focusTarget.scrollIntoView({ block: 'nearest' });
    }
    chatBox.scrollTop = chatBox.scrollHeight;
  }
  chatInput?.focus();

  document.getElementById('chatForm').addEventListener('submit', async (event) => {
    event.preventDefault();
    const payload = Object.fromEntries(new FormData(event.target).entries());
    payload.conversation_id = '<%= conversation.id %>';
    const submitButton = document.getElementById('chatSubmit');
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Отправка...';
    }
    try {
      const response = await csrfFetch('/api/client/chat/message', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload)});
      const result = await response.json();
      document.getElementById('chatResult').textContent = result.ok ? 'Сообщение отправлено.' : result.error;
      if (result.ok) location.reload();
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = 'Отправить';
      }
    }
  });
</script>
<%- include('partials/footer') %>
