<%- include('partials/header', { title: 'Главная', user }) %>

<section class="hero">
  <h1><%= settings?.club_name ?? 'FitClub Personal' %></h1>
  <p><%= settings?.description ?? 'Демо-прототип фитнес-клуба' %></p>
  <p><strong>Адрес:</strong> <%= settings?.address ?? '—' %> · <strong>Часы:</strong> <%= settings?.hours ?? '—' %></p>
</section>

<section>
  <h2>Лид-магнит</h2>
  <form id="leadForm" class="card grid-3">
    <input name="name" placeholder="Ваше имя" required />
    <input name="contact" placeholder="Телефон или email" required />
    <select name="interest">
      <option value="Пробная тренировка">Пробная тренировка</option>
      <option value="Консультация с тренером">Консультация с тренером</option>
      <option value="Стартовая неделя">Стартовая неделя</option>
    </select>
    <button type="submit">Отправить заявку</button>
  </form>
  <p id="leadResult" class="muted"></p>
</section>

<section class="grid-2">
  <div>
    <h2>Тренеры</h2>
    <% trainers.forEach((t) => { %>
      <article class="card">
        <h3><%= t.name %></h3>
        <p><strong><%= t.specialization %></strong></p>
        <p><%= t.description %></p>
      </article>
    <% }) %>
  </div>
  <div>
    <h2>Тарифы (демо)</h2>
    <% types.forEach((t) => { %>
      <article class="card">
        <h3><%= t.name %></h3>
        <p><%= t.description %></p>
        <p><strong><%= t.demo_price %> ₽</strong> · демонстрационно</p>
      </article>
    <% }) %>
  </div>
</section>

<section>
  <h2>Ближайшее расписание</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Занятие</th><th>Начало</th><th>Окончание</th><th>Мест</th></tr></thead>
      <tbody>
      <% schedule.forEach((s) => { %>
        <tr>
          <td><%= s.title %></td>
          <td><%= new Date(s.starts_at).toLocaleString('ru-RU') %></td>
          <td><%= new Date(s.ends_at).toLocaleString('ru-RU') %></td>
          <td><%= s.capacity %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</section>

<script>
  document.getElementById('leadForm')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.target;
    const payload = Object.fromEntries(new FormData(form).entries());
    const result = await postForm('/api/public/lead', payload);
    document.getElementById('leadResult').textContent = result.ok
      ? 'Спасибо! Заявка создана и передана администратору.'
      : (result.error || 'Ошибка отправки');
    if (result.ok) form.reset();
  });
</script>

<%- include('partials/footer') %>
