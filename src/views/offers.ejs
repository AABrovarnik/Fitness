<%- include('partials/header', { title: 'Тарифы', user }) %>
<h1>Тарифы клуба</h1>
<p class="muted"><%= settings?.club_name ?? 'FitClub Personal' %> · демонстрационные предложения</p>
<nav class="tabs">
  <a href="/">Главная</a>
  <a href="/offers">Тарифы</a>
  <a href="/trainers">Тренеры</a>
  <a href="/schedule">Расписание</a>
  <a href="<%= user?.role === 'client' ? '/client' : '/register' %>"><%= user?.role === 'client' ? 'Кабинет' : 'Регистрация' %></a>
</nav>
<section class="grid-3">
  <% types.forEach((t) => { %>
    <article class="card offer-card">
      <h2><%= t.name %></h2>
      <p><%= t.description %></p>
      <p class="price"><%= t.demo_price %> ₽</p>
      <p class="muted">Срок: <%= t.duration_days %> дней · Лимит: <%= t.visit_limit ?? 'безлимит' %></p>
      <a class="btn" href="<%= user?.role === 'client' ? '/client/chat?mode=human' : '/register?intent=booking' %>">Выбрать тариф</a>
    </article>
  <% }) %>
</section>
<%- include('partials/footer') %>
