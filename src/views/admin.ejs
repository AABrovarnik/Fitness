<%- include('partials/header', { title: 'Админка', user }) %>
<h1>Административная панель</h1>
<nav class="tabs">
  <a href="/admin">Сводка</a>
  <a href="/admin/clients">Клиенты</a>
  <a href="/admin/memberships">Абонементы</a>
  <a href="/admin/schedule">Расписание</a>
  <a href="/admin/equipment">Оборудование</a>
  <a href="/admin/conversations">Обращения</a>
  <a href="/admin/settings">Настройки</a>
</nav>
<section class="grid-3">
  <article class="card"><h2>Клиенты</h2><p><%= stats.clients %></p></article>
  <article class="card"><h2>Новые лиды</h2><p><%= stats.leadsNew %></p></article>
  <article class="card"><h2>Активные обращения</h2><p><%= stats.conversations %></p></article>
</section>
<section>
  <h2>Абонементы истекают в 14 дней</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Клиент</th><th>Дата</th></tr></thead>
      <tbody>
      <% expiring.forEach((item) => { %><tr><td><%= item.name %></td><td><%= new Date(item.ends_at).toLocaleDateString('ru-RU') %></td></tr><% }) %>
      </tbody>
    </table>
  </div>
</section>
<section>
  <h2>Активные записи (подтверждение посещения)</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Клиент</th><th>Событие</th><th>Начало</th><th>Статус</th><th>Действие</th></tr></thead>
      <tbody>
      <% bookings.forEach((item) => { %>
        <tr>
          <td><%= item.client_name %></td>
          <td><%= item.title %></td>
          <td><%= formatDateTime(item.starts_at) %></td>
          <td><%= item.status %></td>
          <td>
            <button onclick="setBookingStatus('<%= item.id %>', 'completed')">Посещение было</button>
            <button class="danger" onclick="setBookingStatus('<%= item.id %>', 'no_show')">Не пришёл</button>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <p id="adminBookingResult" class="muted"></p>
</section>
<script>
  async function setBookingStatus(id, status) {
    const response = await csrfFetch(`/api/admin/bookings/${id}/status`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status })
    });
    const result = await response.json();
    document.getElementById('adminBookingResult').textContent = result.ok ? 'Статус обновлён.' : result.error;
    if (result.ok) {
      location.reload();
    }
  }
</script>
<%- include('partials/footer') %>
